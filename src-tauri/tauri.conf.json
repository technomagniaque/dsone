{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dsone",
  "version": "0.24.0",
  "identifier": "io.github.technomagniaque.dsone",
  "mainBinaryName": "dsone",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "dsone",
        "width": 1200,
        "height": 800,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "libgstreamer1.0-0",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav",
          "gstreamer1.0-alsa",
          "gstreamer1.0-pipewire",
          "libsecret-1-0",
          "libasound2 | libasound2t64",
          "librsvg2-common",
          "pulseaudio-utils"
        ],
        "section": "sound",
        "priority": "optional",
        "desktopTemplate": "dsone.desktop.hbs"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libappindicator-gtk3",
          "gstreamer1",
          "gstreamer1-plugins-base",
          "gstreamer1-plugins-good",
          "gstreamer1-plugins-bad-free",
          "gstreamer1-plugin-libav",
          "pipewire-gstreamer",
          "alsa-lib",
          "libsecret",
          "librsvg2",
          "pulseaudio-utils"
        ],
        "release": "1",
        "desktopTemplate": "dsone.desktop.hbs"
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "shortDescription": "Native Deezer and TIDAL client, bit-perfect audio",
    "longDescription": "dsone is a fork of SONE (by lullabyX) adding a native Deezer client next to TIDAL, with bit-perfect playback, exclusive ALSA output, PipeWire and Signal Path transparency.",
    "homepage": "https://github.com/technomagniaque/dsone",
    "license": "GPL-3.0-only"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["tidal", "deezer"]
      }
    }
  }
}
